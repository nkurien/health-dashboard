{
  "name": "health-journal-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:web": "npm --prefix ../frontend run build",
    "deploy": "npm run build:web && wrangler deploy",
    "types": "wrangler types --strict-vars=false",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
