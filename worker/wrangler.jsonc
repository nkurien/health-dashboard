{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "health-journal",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],

  // Only reachable through the custom domain below, which sits behind Cloudflare Access.
  "workers_dev": false,
  "preview_urls": false,

  // Serves the static frontend (next build -> ../frontend/out). run_worker_first lets the
  // Worker check the Access login before serving *anything*, pages included.
  "assets": {
    "directory": "../frontend/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },

  // Only reachable here, behind Cloudflare Access (the domain must be on Cloudflare DNS).
  "routes": [{ "pattern": "health.kajalandnathan.com", "custom_domain": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "health-journal",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // IANA timezone that defines "today" and the wake-up day for sleep
    "TIMEZONE": "Europe/London",
    "STEP_GOAL": "10000",
    // Fail closed: refuse to serve data unless Access is configured (set false only in .dev.vars)
    "REQUIRE_ACCESS": "true",

    // Fill these in for your deployment (see README.md):
    "PUBLIC_URL": "https://health.kajalandnathan.com",  // OAuth redirect = PUBLIC_URL/auth/callback
    "ACCESS_TEAM_DOMAIN": "",  // e.g. https://your-team.cloudflareaccess.com
    "ACCESS_AUD": "",          // the Access application's AUD tag

    // Local development only (set in .dev.vars):
    "FRONTEND_URL": "",
    "DEV_CORS_ORIGIN": ""
  },

  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
